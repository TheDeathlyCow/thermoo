{
    "schemaVersion": 1,
    "id": "thermoo",
    "version": "${version}",
    "name": "Thermoo",
    "description": "A temperature and environment library for Fabric mods",
    "authors": [
        "TheDeathlyCow"
    ],
    "contact": {
        "homepage": "https://thermoo.thedeathlycow.com/",
        "sources": "https://github.com/TheDeathlyCow/thermoo",
        "issues": "https://github.com/TheDeathlyCow/thermoo/issues"
    },
    "license": "LGPL-3.0",
    "icon": "assets/thermoo/icon.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.github.thedeathlycow.thermoo.impl.Thermoo"
        ],
        "client": [
            "com.github.thedeathlycow.thermoo.impl.ThermooClient"
        ],
        "server": [
            "com.github.thedeathlycow.thermoo.impl.ThermooServer"
        ],
        "cardinal-components-entity": [
            "com.github.thedeathlycow.thermoo.impl.component.ThermooComponents"
        ],
        "thermoo-dependent-mod-server": [
            "com.github.thedeathlycow.thermoo.impl.compat.polymer.ThermooPolymerPatch"
        ]
    },
    "mixins": [
        "thermoo.mixins.json",
        {
            "config": "thermoo.client.mixins.json",
            "environment": "client"
        }
    ],
    "depends": {
        "fabricloader": ">=0.18.4",
        "fabric-api": ">=0.143.10",
        "minecraft": "~26.1-",
        "java": ">=25",
        "cardinal-components-base": "~8.0-",
        "cardinal-components-entity": "~8.0-"
    },
    "suggests": {
        "frostiful": "*",
        "scorchful": "*"
    },
    "accessWidener": "thermoo.accesswidener",
    "custom": {
        "loom:injected_interfaces": {
            "net/minecraft/world/entity/LivingEntity": [
                "com/github/thedeathlycow/thermoo/api/core/v1/TemperatureAware",
                "com/github/thedeathlycow/thermoo/api/core/v1/Soakable"
            ],
            "net/minecraft/world/level/Level": [
                "com/github/thedeathlycow/thermoo/api/core/v1/ThermooLevel"
            ]
        },
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.thedeathlycow.com/",
                "modmenu.wiki": "https://thermoo.thedeathlycow.com/"
            },
            "badges": [
                "library"
            ]
        },
        "cardinal-components": [
            "thermoo:temperature",
            "thermoo:wetness",
            "thermoo:temperature_effects"
        ]
    }
}
